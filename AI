  <title>Engine Simulator</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&amp;family=Noto+Sans+KR:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/lucide@0.577.0/dist/umd/lucide.min.js"></script>
  <style>
    :root{--bg:#090c11;--panel:#171d25;--line:#3a4753;--text:#f5f7fa;--muted:#9baab7;--blue:#55b9ff;--red:#ff4b55}
    *{box-sizing:border-box}html{scroll-behavior:smooth}
    body{margin:0;color:var(--text);font-family:"Noto Sans KR",sans-serif;background:radial-gradient(ellipse at 50% -15%,#293543 0%,transparent 55%),repeating-linear-gradient(105deg,#ffffff03 0 1px,transparent 1px 5px),var(--bg)}
    button,input,select,textarea{font-family:"Noto Sans KR",sans-serif}button{cursor:pointer}:focus-visible{outline:2px solid #8ed4ff;outline-offset:3px}
    .shell{width:min(100% - 44px,1280px);margin:auto}
    .site-header{min-height:76px;display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #ffffff20}
    .brand{display:flex;align-items:center;gap:12px;font:800 17px "DM Sans",sans-serif;letter-spacing:.15em}
    .header-label,.eyebrow,.panel-title,.control-heading,.readout-label{font:700 11px "DM Sans",sans-serif;letter-spacing:.17em}.header-label{color:var(--muted)}
    main{padding:36px 0 60px}.intro{display:flex;justify-content:space-between;align-items:end;gap:25px;margin-bottom:28px}.eyebrow{color:var(--blue);text-transform:uppercase}.intro h1{font-size:clamp(32px,4vw,56px);line-height:1.2;letter-spacing:-.06em;margin:10px 0}.intro p{font-size:13px;color:var(--muted);line-height:1.8;margin:0}.intro-note{text-align:right;color:var(--muted);font:700 11px/2 "DM Sans",sans-serif;letter-spacing:.1em}
    .dashboard{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(340px,.7fr);gap:18px;align-items:start}
    .panel{background:linear-gradient(145deg,#222b34,#141b22 50%,#0e1319);border:1px solid #65727a55;border-radius:22px;box-shadow:inset 0 1px #ffffff14,0 28px 55px #0008}
    .gauge-panel{padding:25px;min-height:650px;display:flex;flex-direction:column;background:repeating-linear-gradient(135deg,#ffffff04 0 1px,transparent 1px 5px),linear-gradient(150deg,#222b34,#090d12 58%,#1d252e);border-color:#5a6773}
    .panel-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.panel-title,.control-heading{color:#c7d4de}.status{display:flex;align-items:center;gap:8px;color:var(--muted);font:700 11px "DM Sans",sans-serif;letter-spacing:.08em}.status-dot{width:8px;height:8px;background:#657078;border-radius:50%}.status.running{color:var(--blue)}.status.running .status-dot{background:var(--blue);box-shadow:0 0 13px var(--blue)}
    .cluster-frame{position:relative;margin:19px 0 16px;padding:19px;border:1px solid #7a8894;border-radius:36px 36px 22px 22px;background:linear-gradient(145deg,#65727e 0%,#111922 3%,#05080c 19%,#101821 65%,#04070b 88%,#485561);box-shadow:inset 0 2px 3px #ffffff58,inset 0 0 0 6px #05080c,0 20px 35px #000d;overflow:hidden}
    .cluster-frame:before{content:"";position:absolute;inset:9px;border:1px solid #ffffff16;border-radius:28px 28px 16px 16px;pointer-events:none}.cluster-frame:after{content:"";position:absolute;inset:8% 15% auto;height:30%;background:linear-gradient(#ffffff0b,transparent);transform:skewX(-28deg);pointer-events:none}
    .cluster-header,.cluster-bottom{position:relative;z-index:2;display:flex;align-items:center;justify-content:space-between;gap:10px;font:700 10px "DM Sans",sans-serif;letter-spacing:.14em;color:#9bb0c2}.drive-mode{color:#76c9ff;text-shadow:0 0 12px #38a9ff88}.cluster-lamps{display:flex;gap:13px;align-items:center}.lamp{color:#4d5d69;transition:color .2s,text-shadow .2s}.lamp svg{width:15px;height:15px}.cluster-frame[data-phase="lamps"] .lamp,.cluster-frame[data-phase="sweep"] .lamp,.cluster-frame[data-phase="crank"] .lamp{color:#ffac56;text-shadow:0 0 12px #ff8b3b}.cluster-frame[data-phase="on"] .lamp:first-child{color:#49d7a9}
    .instrument-grid{position:relative;z-index:1;display:grid;grid-template-columns:minmax(68px,1fr) minmax(0,3.9fr) minmax(68px,1fr);align-items:center;gap:3px;margin:14px 0 6px}
    .side-stack{display:flex;flex-direction:column;gap:13px;align-self:stretch;justify-content:center}.side-readout{border-top:1px solid #3e5365;padding:8px 2px;background:linear-gradient(#60bbff0a,transparent)}.side-readout .label{display:block;color:#8fa8bc;font:700 9px "DM Sans",sans-serif;letter-spacing:.1em}.side-readout output{display:block;color:#fff;font:800 clamp(15px,2vw,25px) "DM Sans",sans-serif;white-space:nowrap;font-variant-numeric:tabular-nums}.side-readout small{color:#7bbced;font-size:9px}.side-readout .mini-track{height:3px;background:#283b4b;margin-top:8px}.mini-track span{display:block;height:100%;width:0;background:linear-gradient(90deg,#4fb8ff,#e94353);transition:width .15s}
