    for(const mode of ['manual','auto'])$('mode-'+mode).addEventListener('click',()=>{state.shiftMode=mode;drawGauge();if(mode==='auto'&&state.running&&state.gear===0)requestShift(1);render()});
    $('gear-up').addEventListener('click',()=>{if(state.shiftMode==='manual')requestShift(state.gear+1)});
    $('gear-down').addEventListener('click',()=>{if(state.shiftMode==='manual')requestShift(state.gear-1)});
    $('gear-select').addEventListener('change',e=>{if(state.shiftMode==='manual'||state.gear===-1)requestShift(Number(e.target.value))});
    $('auto-keys').addEventListener('change',e=>{state.autoKeys=e.target.value;render()});
    document.addEventListener('keydown',e=>{if(e.repeat||e.isComposing||e.altKey||e.ctrlKey||e.metaKey||! /^[1-8]$/.test(e.key))return;const target=e.target;if(target.closest('input,select,textarea,[contenteditable="true"],[role="textbox"]'))return;if(state.shiftMode==='auto'){if(state.autoKeys==='ignore')return;state.shiftMode='manual';drawGauge()}requestShift(Number(e.key));render()});
    $('volume').addEventListener('input',e=>{state.volume=Number(e.target.value)/100;$('volume-value').textContent=e.target.value+'%';updateAudioStatus()});
    document.querySelectorAll('[data-pop]').forEach(button=>button.addEventListener('click',()=>{state.popLevel=button.dataset.pop;if(audioNodes)audioNodes.popBus.gain.setTargetAtTime(state.popLevel==='off'?0:.72,context.currentTime,.008);if(state.popLevel==='off'){state.pop=0;state.popWindow=0}document.querySelectorAll('[data-pop]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});render()}));
    document.querySelectorAll('[data-cylinders]').forEach(button=>button.addEventListener('click',()=>{state.cylinders=Number(button.dataset.cylinders);phase=0;updateEngineAudio();render()}));
    document.querySelectorAll('[data-exhaust]').forEach(button=>button.addEventListener('click',()=>{state.exhaust=button.dataset.exhaust;document.querySelectorAll('[data-exhaust]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button))});render()}));
    $('exhaust-tip').addEventListener('change',e=>{state.tip=e.target.value;render()});
    $('mute-button').addEventListener('click',()=>{state.muted=!state.muted;const icon=$('mute-button').querySelector('svg');if(icon)icon.remove();$('mute-button').insertAdjacentHTML('afterbegin',`<i data-lucide="${state.muted?'volume-x':'volume-2'}"></i>`);lucide.createIcons();render();updateAudioStatus()});
    const immersiveButton=$('immersive-toggle'),dashboard=document.querySelector('.dashboard');
    let cockpitScroll=0;
    function setImmersive(on){
      if(on===dashboard.classList.contains('immersive'))return;
      if(on)cockpitScroll=window.scrollY;
      dashboard.classList.toggle('immersive',on);
      document.body.style.overflow=on?'hidden':'';
      immersiveButton.setAttribute('aria-pressed',String(on));
      immersiveButton.setAttribute('aria-label',on?'전체화면 닫기':'계기판 전체화면 열기');
      immersiveButton.querySelector('span').textContent=on?'닫기':'전체화면';
      const icon=immersiveButton.querySelector('svg');if(icon)icon.remove();
      immersiveButton.insertAdjacentHTML('afterbegin',`<i data-lucide="${on?'minimize':'maximize'}"></i>`);lucide.createIcons();
      if(on)dashboard.scrollTop=0;else window.scrollTo({top:cockpitScroll,behavior:'instant'});
    }
    immersiveButton.addEventListener('click',async()=>{
      if(document.fullscreenElement){try{await document.exitFullscreen()}catch(e){setImmersive(false)}return}
      try{await dashboard.requestFullscreen();setImmersive(true)}catch(e){setImmersive(false);immersiveButton.setAttribute('aria-label','브라우저에서 전체화면을 허용해 주세요')}
    });
    document.addEventListener('fullscreenchange',()=>setImmersive(document.fullscreenElement===dashboard));
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!document.fullscreenElement&&dashboard.classList.contains('immersive'))setImmersive(false)});
    let backendRecords=[],recordsReady=false,recordTimer;
    function recordMessage(message){$('record-status').textContent=message}
    function renderBest(){const values=backendRecords;const bestZero=values.map(r=>r.zero_to_100).filter(v=>typeof v==='number'&&v>0);const bestQuarter=values.map(r=>r.quarter_mile).filter(v=>typeof v==='number'&&v>0);const bestTop=values.map(r=>r.top_speed).filter(v=>typeof v==='number'&&v>0);$('best-zero').textContent=bestZero.length?Math.min(...bestZero).toFixed(2)+' s':'—';$('best-quarter').textContent=bestQuarter.length?Math.min(...bestQuarter).toFixed(2)+' s':'—';$('best-top').textContent=bestTop.length?Math.round(Math.max(...bestTop))+' km/h':'—'}
    const recordHandler={onDataChanged(data){clearTimeout(recordTimer);backendRecords=data;recordsReady=true;renderBest();recordMessage('최고 기록을 불러왔습니다. '+backendRecords.length+'/999')}};
    async function initRecords(){recordsReady=false;recordMessage('기록을 불러오는 중…');clearTimeout(recordTimer);recordTimer=setTimeout(()=>{if(!recordsReady)recordMessage('기록을 불러오지 못했습니다. 다시 시도하려면 여기를 누르세요.')},8000);try{const result=await window.dataSdk.init(recordHandler);if(!result.isOk){clearTimeout(recordTimer);recordMessage('기록 연결 실패 · 여기를 눌러 다시 시도하세요')}}catch(e){clearTimeout(recordTimer);recordMessage('기록 연결 실패 · 여기를 눌러 다시 시도하세요')}}
    $('record-status').addEventListener('click',()=>{if(!recordsReady)initRecords()});
    $('save-record').addEventListener('click',async e=>{const button=e.currentTarget;if(!recordsReady){recordMessage('기록 연결 후 저장할 수 있습니다.');return}if(!state.runTop){recordMessage('주행 후 기록을 저장할 수 있습니다.');return}if(backendRecords.length>=999){recordMessage('저장 한도 999개에 도달했습니다.');return}button.disabled=true;button.textContent='저장 중…';try{const result=await window.dataSdk.create({zero_to_100:state.runZero,top_speed:state.runTop,quarter_mile:state.runQuarter,recorded_at:new Date().toISOString()});recordMessage(result.isOk?'주행 기록을 저장했습니다.':'저장을 확인할 수 없습니다. 새로고침 후 확인하세요.')}catch(err){recordMessage('저장을 확인할 수 없습니다. 새로고침 후 확인하세요.')}finally{button.disabled=false;button.textContent='현재 기록 저장'}});
    render();initRecords();requestAnimationFrame(animate);
  </script>
 </body>
</html>
